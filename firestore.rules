rules_version = '2';

// Fairplan: Zugriff nur mit bekanntem Haushalts-Code.
// Haushalte lassen sich nicht auflisten; nur angemeldete (anonyme) Nutzer.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdExists(code) {
      return exists(/databases/$(database)/documents/households/$(code));
    }

    match /households/{code} {
      // Einzelnes Dokument lesen (Code muss bekannt sein), niemals auflisten
      allow get: if signedIn();
      allow list: if false;
      // Codes: 16 Zeichen aus A–Z (ohne I, O) und 2–9
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{16}$');
      allow update: if signedIn();
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, write: if signedIn() && householdExists(code);
      }

      match /completions/{completionId} {
        allow read, write: if signedIn() && householdExists(code);
      }
    }
  }
}
